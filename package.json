{
	"name": "vscode-asciidoc-slides",
	"displayName": "AsciiDoc Slides",
	"description": "Create a presentation via AsciiDoc",
	"version": "1.3.0",
	"packageManager": "bun@1.3.11",
	"publisher": "flobilosaurus",
	"repository": {
		"type": "git",
		"url": "https://github.com/flobilosaurus/vscode-asciidoc-slides.git"
	},
	"license": "MIT",
	"engines": {
		"node": ">=20",
		"vscode": "^1.125.0"
	},
	"categories": [
		"Other"
	],
	"icon": "media/icon.png",
	"keywords": [
		"asciidoc",
		"reveal.js",
		"slides",
		"presentation"
	],
	"activationEvents": [
		"onCommand:asciidocSlides.preview",
		"onCommand:asciidocSlides.exportHtml",
		"onCommand:asciidocSlides.exportInlinedHtml",
		"onCommand:asciidocSlides.openInBrowser"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "asciidocSlides.preview",
				"title": "Asciidoc Slides: Show Slides Preview Beside",
				"category": "Asciidoc Slides"
			},
			{
				"command": "asciidocSlides.openInBrowser",
				"title": "Asciidoc Slides: Open Slides in Browser",
				"category": "Asciidoc Slides"
			},
			{
				"command": "asciidocSlides.exportHtml",
				"title": "Asciidoc Slides: Export slides to Html file",
				"category": "Asciidoc Slides"
			},
			{
				"command": "asciidocSlides.exportInlinedHtml",
				"title": "Asciidoc Slides: Export slides to inlined Html file",
				"category": "Asciidoc Slides"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "webpack --mode production",
		"webpack": "webpack --mode development",
		"webpack-dev": "webpack --mode development --watch",
		"compile": "tsc -p ./",
		"test:node": "mocha --ui tdd \"out/test/node/**/*.test.js\"",
		"test:extension": "bun run compile && node ./out/test/runExtensionTests.js",
		"test:coverage": "c8 --reporter=text --reporter=lcov --exclude=out/test/** --exclude=out/extension.js bun run test:node",
		"test": "bun run compile && bun run test:node && bun run test:extension"
	},
	"devDependencies": {
		"@types/glob": "^9.0.0",
		"@types/mocha": "10.0.10",
		"@types/node": "^26.1.2",
		"@types/vscode": "^1.125.0",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"@vscode/test-electron": "3.1.0",
		"c8": "12.0.0",
		"eslint": "^10.8.0",
		"glob": "^13.0.6",
		"mocha": "11.7.6",
		"ts-loader": "^9.6.2",
		"typescript": "6.0.2",
		"webpack": "^5.109.0",
		"webpack-cli": "^7.2.1"
	},
	"dependencies": {
		"@asciidoctor/reveal.js": "^5.2.0",
		"@types/axios": "^0.14.4",
		"@types/chai": "^5.2.3",
		"@types/koa": "^3.0.3",
		"@types/koa-ejs": "^4.3.3",
		"@types/koa-favicon": "^2.1.4",
		"@types/koa-logger": "^3.1.5",
		"@types/koa-send": "^4.1.6",
		"@types/slash": "^3.0.0",
		"@types/web-resource-inliner": "^4.2.5",
		"@types/ws": "^8.18.1",
		"asciidoctor": "^4.0.6",
		"asciidoctor-kroki": "^1.0.1",
		"asciidoctor-kroki-legacy": "npm:asciidoctor-kroki@0.18.1",
		"asciidoctor-legacy": "npm:@asciidoctor/core@3.0.4",
		"axios": "^1.18.1",
		"chai": "^6.2.2",
		"font-awesome": "^4.7.0",
		"highlight.js": "^11.11.1",
		"koa": "^3.2.1",
		"koa-easy-ws": "^2.1.0",
		"koa-ejs": "^4.3.0",
		"koa-favicon": "^2.1.0",
		"koa-logger": "^4.0.0",
		"koa-send": "^5.0.1",
		"open": "^11.0.0",
		"reveal.js": "^6.0.1",
		"slash": "^5.1.0",
		"web-resource-inliner": "^8.0.0",
		"ws": "^8.21.1"
	}
}
